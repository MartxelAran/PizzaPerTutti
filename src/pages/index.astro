---
import "../styles/global.css";

import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import MenuCards from "../components/MenuCards.astro";
import About from "../components/About.astro";
import Gallery from "../components/Gallery.astro";
import Reviews from "../components/Reviews.astro";
import Contact from "../components/Contacto.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Pizza Per Tutti, pizzería en Arrasate. Pizzas italianas para llevar y a domicilio. Consulta la carta y haz tu pedido."
    />
    <title>Pizza Per Tutti</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lobster&family=Open+Sans:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <link rel="canonical" href="https://pizzapertutti.net/" />
    <link rel="icon" href="/images/logo.ico" sizes="any" />
    <style>
      body {
        font-family: Poppins, sans-serif;
      }
    </style>
  </head>
  <body class="bg-ppt-cream text-ppt-wood">
    <Header
      siteTitle="Pizza Per Tutti"
      weeklyHoursText="Dom, Mar, Mié y Jue 18:30 - 22:30 · Vie y Sáb 18:30 - 23:00"
      town="Arrasate"
    />

    <main>
      <Hero headline="Auténtica pizza italiana. Para llevar o a domicilio." />
      <About />
      <MenuCards limit_cards={true} />
      <Reviews />
      <Contact />
    </main>

    <Footer />

    <!-- Floating phone call button -->
    <a
      href="tel:+34943797526"
      class="fixed bottom-6 right-6 z-50 bg-ppt-red text-white p-4 rounded-full shadow-lg hover:bg-[#867d97] transition-all hover:scale-110"
      aria-label="Llamar por teléfono"
      title="Llamar ahora"
    >
      📞
    </a>
  </body>
</html>
